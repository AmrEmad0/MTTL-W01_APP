{
  "name": "mttl-control",
  "private": true,
  "version": "0.0.1-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests vite.config.ts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run test && bun run typecheck",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "^1.4.2",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16"
  },
  "description": "Local desktop controller for MTTL-W01 smart power strips",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmrEmad0/MTTL-W01_APP.git"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  }
}
